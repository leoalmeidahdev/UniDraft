# Painel do projeto Supabase: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service role) - NUNCA expor ao client, usar só em scripts/route handlers server-side
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão direta ao Postgres (Settings > Database > Connection string > URI), usada pelo Drizzle
DATABASE_URL=
